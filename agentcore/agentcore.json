{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "FundSentinel",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "FundSentinel"
  },
  "runtimes": [
    {
      "name": "pipeline",
      "description": "FundSentinel pipeline: Profiler mapping, 4 reviewers, Decision owner, S3 + Aurora writes",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "runtime/",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "additionalPolicies": [
        "iam-policy.json"
      ],
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 900,
        "maxLifetime": 28800
      }
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}
